<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
  </head>
  <body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #2196F3;">{{ heading }}</h2>
    <p>{{ i18n.t('emails.supplier_change_intro', { name }) }}</p>
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
      @each((row, index) in rows)
        <tr style="{{ index % 2 === 0 ? 'background: #f5f5f5;' : '' }}">
          <td style="padding: 8px; border: 1px solid #ddd; width: 40%;">{{ row.label }}</td>
          <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">{{ row.value }}</td>
        </tr>
      @end
    </table>
    <p>{{ i18n.t('emails.supplier_change_note') }}</p>
    <p style="margin: 24px 0; text-align: center;">
      <a
        href="{{ ctaUrl }}"
        style="background-color: #2196F3; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold;"
      >
        {{ i18n.t('emails.supplier_change_cta') }}
      </a>
    </p>
    <p style="color: #666; font-size: 12px;">
      —
      <a href="{{ appUrl }}" style="color: #cf112a; text-decoration: none;">
        {{ i18n.t('common.app_name', { app_name: appName }) }}
      </a>
    </p>
  </body>
</html>
