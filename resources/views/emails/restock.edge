<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
  </head>
  <body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    @if(items.length === 1)
      <h2 style="color: #4CAF50;">{{ i18n.t('emails.restock_heading') }}</h2>
      <p>{{ i18n.t('emails.restock_intro', { name }) }}</p>
    @else
      <h2 style="color: #4CAF50;">{{ i18n.t('emails.restock_heading_many') }}</h2>
      <p>{{ i18n.t('emails.restock_intro_many', { name }) }}</p>
    @end

    <table
      style="width: 100%; border-collapse: separate; border-spacing: 0 8px; margin: 12px 0 20px;"
    >
      @each(item in items)
        <tr>
          <td
            style="padding: 12px 14px; border: 1px solid #ddd; border-right: none; border-left: 4px solid #4CAF50; border-radius: 4px 0 0 4px;"
          >
            <div style="font-size: 16px; font-weight: bold;">{{ item.productName }}</div>
            <div style="color: #888; font-size: 13px; margin-top: 4px;">
              {{
                i18n.t('emails.restock_item_meta', {
                  supplier: item.supplierName,
                  amount: item.amount,
                })
              }}
            </div>
          </td>
          <td
            style="padding: 12px 14px; border: 1px solid #ddd; border-left: none; border-radius: 0 4px 4px 0; text-align: right; white-space: nowrap; font-size: 16px; font-weight: bold;"
          >
            {{ i18n.t('common.price_with_currency', { price: item.price }) }}
          </td>
        </tr>
      @end
    </table>

    <p style="margin: 24px 0; text-align: center;">
      <a
        href="{{ shopUrl }}"
        style="background-color: #4CAF50; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold;"
      >
        {{ i18n.t('emails.purchase_visit_shop') }}
      </a>
    </p>
    <p style="color: #666; font-size: 12px;">
      —
      <a href="{{ appUrl }}" style="color: #cf112a; text-decoration: none;">
        {{ i18n.t('common.app_name', { app_name: appName }) }}
      </a>
    </p>
  </body>
</html>
