<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
  </head>
  <body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #FF9800;">{{ i18n.t('emails.price_correction_heading') }}</h2>
    <p>
      {{
        i18n.t('emails.price_correction_intro', {
          name,
          productName,
          supplierName,
        })
      }}
    </p>
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
      <tr style="background: #FF9800; color: white;">
        <td style="padding: 10px; font-weight: bold;">{{ i18n.t('emails.purchase_product') }}</td>
        <td style="padding: 10px; text-align: right;">{{ productName }}</td>
      </tr>
      <tr style="background: #f5f5f5;">
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_old_price') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
          {{ i18n.t('emails.price_correction_amount', { price: oldPrice }) }}
        </td>
      </tr>
      <tr>
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_new_price') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-weight: bold;">
          {{ i18n.t('emails.price_correction_amount', { price: newPrice }) }}
        </td>
      </tr>
      <tr style="background: #f5f5f5;">
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_count') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
          {{ i18n.t('emails.price_correction_pieces', { count }) }}
        </td>
      </tr>
      <tr>
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_difference') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-weight: bold;">
          {{ i18n.t('emails.price_correction_amount', { price: difference }) }}
        </td>
      </tr>
      <tr style="background: #f5f5f5;">
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_reason') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">{{ reason }}</td>
      </tr>
      <tr>
        <td style="padding: 8px; border: 1px solid #ddd;">
          {{ i18n.t('emails.price_correction_actor') }}
        </td>
        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">{{ actorName }}</td>
      </tr>
    </table>
    <p>{{ i18n.t('emails.price_correction_note') }}</p>
    <p style="margin: 24px 0; text-align: center;">
      <a
        href="{{ ordersUrl }}"
        style="background-color: #FF9800; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold;"
      >
        {{ i18n.t('emails.price_correction_cta') }}
      </a>
    </p>
    <p style="color: #666; font-size: 12px;">
      —
      <a href="{{ appUrl }}" style="color: #cf112a; text-decoration: none;">
        {{ i18n.t('common.app_name', { app_name: appName }) }}
      </a>
    </p>
  </body>
</html>
